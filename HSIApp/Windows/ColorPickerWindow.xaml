<Window x:Class="HSIApp.Windows.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Color"
        Width="300"
        Height="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Preview -->
        <Border x:Name="ColorPreview"
                Grid.Row="0"
                Height="45"
                Margin="0,0,0,15"
                BorderBrush="Gray"
                BorderThickness="1"/>

        <!-- Red -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">

            <TextBlock Text="R:"
                       Width="25"
                       VerticalAlignment="Center"/>

            <Slider x:Name="RedSlider"
                    Minimum="0"
                    Maximum="255"
                    Width="180"
                    ValueChanged="ColorSlider_ValueChanged"/>

            <TextBlock x:Name="RedLabel"
                       Width="35"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"/>

        </StackPanel>

        <!-- Green -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">

            <TextBlock Text="G:"
                       Width="25"
                       VerticalAlignment="Center"/>

            <Slider x:Name="GreenSlider"
                    Minimum="0"
                    Maximum="255"
                    Width="180"
                    ValueChanged="ColorSlider_ValueChanged"/>

            <TextBlock x:Name="GreenLabel"
                       Width="35"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"/>

        </StackPanel>

        <!-- Blue -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    VerticalAlignment="Top"
                    Margin="0,0,0,8">

            <TextBlock Text="B:"
                       Width="25"
                       VerticalAlignment="Center"/>

            <Slider x:Name="BlueSlider"
                    Minimum="0"
                    Maximum="255"
                    Width="180"
                    ValueChanged="ColorSlider_ValueChanged"/>

            <TextBlock x:Name="BlueLabel"
                       Width="35"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"/>

        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Cancel"
                    Width="70"
                    Margin="0,0,5,0"
                    Click="Cancel_Click"/>

            <Button Content="OK"
                    Width="70"
                    Click="Ok_Click"/>

        </StackPanel>

    </Grid>

</Window>
