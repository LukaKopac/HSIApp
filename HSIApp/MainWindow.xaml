<Window x:Class="HSIApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HSIApp.Controls"
        Title="HSI Viewer"
        Height="700"
        Width="1200">

    <DockPanel>

        <!-- Top menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Cube"
                          Click="OpenCube_Click"/>
                
                <MenuItem Header="_Open Project"/>
                <Separator/>
                <MenuItem Header="_Exit"/>
            </MenuItem>

            <MenuItem Header="_Edit"/>

            <MenuItem Header="_View"/>
        </Menu>
        
        <!--Toolbar-->
        <controls:AppToolbar DockPanel.Dock="Top"/>


        <!-- Main application area -->
        <Grid>

            <Grid.ColumnDefinitions>
                <!-- Project panel -->
                <ColumnDefinition Width="220"/>

                <!-- Workspace -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- LEFT: Project panel -->
            <Border Grid.Column="0"
                    BorderBrush="Gray"
                    BorderThickness="0,0,1,0">

                <StackPanel>

                    <TextBlock Text="PROJECT"
                               FontWeight="Bold"
                               Margin="10"/>

                    <TextBlock Text="Status"
                               Margin="10,5,10,2"/>

                    <TextBlock Text="No cube loaded"
                               Margin="10,0,10,10"/>

                    <TextBlock Text="CUBES"
                               FontWeight="Bold"
                               Margin="10,15,10,5"/>

                    <ListBox Margin="10"/>

                    <TextBlock Text="MODELS"
                               FontWeight="Bold"
                               Margin="10,15,10,5"/>

                    <ListBox Margin="10"/>

                    <TextBlock Text="WORKFLOW"
                               FontWeight="Bold"
                               Margin="10,15,10,5"/>

                </StackPanel>

            </Border>


            <!-- RIGHT: Workspace -->
            <Grid Grid.Column="1"
                  Margin="5">

                <Grid.ColumnDefinitions>
                    <!-- Image viewer -->
                    <ColumnDefinition Width="2*"/>

                    <!-- Spectra -->
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>


                <!-- IMAGE VIEWER -->
                <controls:ImageViewer x:Name="Viewer" 
                                      Grid.Column="0"/>


                <!-- RIGHT SIDE -->
                <Grid Grid.Column="1"
                      Margin="5,0,0,0">

                    <Grid.RowDefinitions>
                        <!-- Spectrum Viewer -->
                        <RowDefinition Height="2*"/>

                        <!-- Spectrum Manager -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <controls:SpectrumViewer x:Name="Spectrum"
                                             Grid.Row="0"/>

                    <controls:SpectrumManager x:Name="SpectrumManager"
                                              Grid.Row="1"
                                              Margin="5,5,5,5"/>

                </Grid>

            </Grid>

        </Grid>

    </DockPanel>

</Window>