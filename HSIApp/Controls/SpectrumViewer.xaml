<UserControl x:Class="HSIApp.Controls.SpectrumViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Plot -->
        <Border Grid.Row="0"
            Margin="5"
            BorderBrush="Gray"
            BorderThickness="1">

            <sp:WpfPlot x:Name="SpectrumPlot"/>

        </Border>

        <!-- Information / controls -->
        <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Margin="5">

            <CheckBox x:Name="InteractiveCheckBox"
                    Content="Interactive"
                    IsChecked="True"
                    Margin="0,0,15,0"
                    Checked="InteractiveCheckBox_Checked"
                    Unchecked="InteractiveCheckBox_Unchecked"/>
            
            <TextBlock x:Name="PixelLabel"
                   Text="Pixel: X = -, Y = -"/>

        </StackPanel>

    </Grid>

</UserControl>
