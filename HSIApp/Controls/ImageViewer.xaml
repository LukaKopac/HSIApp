<UserControl x:Class="HSIApp.Controls.ImageViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HSIApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Image -->

        <Border Grid.Column="0"
                            Margin="5"
                            BorderBrush="Gray"
                            BorderThickness="1">

            <Image x:Name="BandImage"
                               Stretch="Uniform"/>
        </Border>

        <!-- Metadata -->

        <Border Grid.Column="1"
                            Margin="5"
                            Padding="10"
                            BorderBrush="Gray"
                            BorderThickness="1">

            <ScrollViewer>

                <TextBlock x:Name="MetadataDisplay"
                                       FontFamily="Consolas"
                                       TextWrapping="Wrap"/>

            </ScrollViewer>

        </Border>

        <!-- Bottom controls -->

        <StackPanel Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                Margin="5">

            <TextBlock Text="Band:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

            <Slider x:Name="BandSlider"
                                Value="0"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="BandSlider_ValueChanged"
                                Width="350"
                                Minimum="0"
                                Maximum="287"/>

            <TextBlock x:Name="BandLabel"
                                   Margin="15,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="Band 0"/>

        </StackPanel>
    </Grid>
</UserControl>
