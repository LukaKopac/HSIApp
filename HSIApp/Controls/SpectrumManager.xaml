<UserControl x:Class="HSIApp.Controls.SpectrumManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border BorderBrush="Gray"
            BorderThickness="1">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Selected Spectra"
                       FontWeight="Bold"
                       Margin="10,5"/>

            <!-- Actions -->
            <Border Grid.Row="1"
                    Grid.Column="1"
                    BorderBrush="Gray"
                    BorderThickness="1,0,0,0"
                    Margin="0,5,0,5">

                <StackPanel Orientation="Vertical"
                            VerticalAlignment="Top"
                            Margin="3">

                    <Button Style="{StaticResource ToolButtonStyle}"
                            ToolTip="Select all spectra"
                            Click="SelectAllSpectra_Click">
                        <Image Source="/Media/Icons/SelectAll.png"
                               Height="18"
                               Width="18"/>
                    </Button>

                    <Button Style="{StaticResource ToolButtonStyle}"
                            ToolTip="Save selected spectra"
                            Click="SaveSelectedSpectra_Click">
                        <TextBlock Text="💾"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>

                    <Button Style="{StaticResource ToolButtonStyle}"
                            ToolTip="Delete selected spectra"
                            Click="DeleteSelectedSpectra_Click">

                        <Image Source="/Media/Icons/TrashCan.png"
                               Height="18"
                               Width="18"/>
                    </Button>

                </StackPanel>

            </Border>

            <!-- Spectrum list -->
            <ListBox x:Name="SpectrumList"
                     Grid.Row="1"
                     Grid.Column="0"
                     Margin="5"
                     SelectionMode="Extended"
                     SelectionChanged="SpectrumList_SelectionChanged">

                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <Grid Margin="3">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal">

                                <Ellipse Width="10"
                                         Height="10"
                                         Fill="{Binding BrushColor}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0"
                                         MouseLeftButtonDown="SpectrumColor_MouseLeftButtonDown"
                                         Cursor="Hand"/>

                                <Grid>

                                    <TextBlock x:Name="NameDisplay"
                                               Text="{Binding Name}"
                                               FontWeight="Bold"
                                               MouseLeftButtonDown="SpectrumName_MouseLeftButtonDown"/>

                                    <TextBox x:Name="NameEditor"
                                             Text="{Binding Name, UpdateSourceTrigger=Explicit}"
                                             FontWeight="Bold"
                                             Visibility="Collapsed"
                                             BorderThickness="1"
                                             Padding="2"
                                             KeyDown="SpectrumNameEditor_KeyDown"
                                             LostFocus="SpectrumNameEditor_LostFocus"/>

                                </Grid>

                                <TextBlock Text=" (X: "
                                           Margin="5,0,0,0"/>

                                <TextBlock Text="{Binding X}"/>

                                <TextBlock Text=", Y: "/>

                                <TextBlock Text="{Binding Y}"/>

                                <TextBlock Text=")"/>

                            </StackPanel>

                        </Grid>

                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

        </Grid>

    </Border>

</UserControl>
